{
  "name": "dalworld_server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run data:generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "npm run data:generate && npm run typecheck && npm run check:protocol && npm run check:data-sync && npm run build",
    "check:protocol": "node scripts/check-protocol-sync.mjs",
    "check:data-sync": "node scripts/check-game-data-sync.mjs",
    "data:generate": "node scripts/generate-game-data.mjs",
    "db:migrate:local": "wrangler d1 migrations apply dalworld-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dalworld-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250510.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
